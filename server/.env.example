# Copy to server/.env and fill in. Never commit the real file.

# From https://discord.com/developers/applications > your app > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The redirect registered in Discord must be PUBLIC_URL + /auth/discord/callback
PUBLIC_URL=http://localhost:8787
# In production: PUBLIC_URL=https://doodlehive.net (and CLIENT_URL can be left out)
# Where the app runs during development (Vite)
CLIENT_URL=http://localhost:5173

# Fake "dev" logins for testing. Defaults to on when Discord is not configured.
# DEV_LOGIN=1
# PORT=8787

# Push notifications for the iPad app (see DEPLOY.md → iPad app). Leave empty to send none.
# APNS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----   (or APNS_KEY_FILE=/path/AuthKey_XXXX.p8)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=net.doodlehive.app
