{
  "name": "doodlehive-desktop",
  "productName": "Doodlehive",
  "version": "0.22.0",
  "description": "Drawing together with friends",
  "author": "Doodlehive",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "net.doodlehive.app",
    "productName": "Doodlehive",
    "copyright": "Doodlehive",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "store.cjs"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://downloads.doodlehive.net"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Doodlehive-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "artifactName": "Doodlehive-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "fileAssociations": [
      {
        "ext": "hivecanvas",
        "name": "Doodlehive canvas",
        "description": "Doodlehive canvas",
        "role": "Editor",
        "mimeType": "application/x-doodlehive-canvas"
      },
      {
        "ext": "hivelapse",
        "name": "Doodlehive timelapse",
        "description": "Doodlehive timelapse",
        "role": "Viewer",
        "mimeType": "application/x-doodlehive-timelapse"
      }
    ]
  }
}
