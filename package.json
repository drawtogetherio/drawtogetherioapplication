{
  "name": "doodlehive",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "build": "tsc && vite build && node scripts/check-build.mjs",
    "build:single": "tsc && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc && tsc -p server",
    "build:preview": "npm run build:single && node scripts/make-preview.mjs",
    "dev:web": "vite --host",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "admin": "tsx server/admin.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "ag-psd": "^31.0.3",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
